# Contoh /opt/klinik/.env di server — dibaca `env_file` di compose.yml.
#
# Pasang dengan izin ketat:
#   cp deploy/env.production.example /opt/klinik/.env
#   nano /opt/klinik/.env
#   chmod 600 /opt/klinik/.env
#
# Berkas ini tidak pernah ikut ke dalam image: .dockerignore menahannya, dan
# Docker menyuntikkan isinya sebagai environment saat container dijalankan.

# === Database ===
# 127.0.0.1 tetap benar walau aplikasi berjalan di container: compose memakai
# network_mode: host, jadi container memakai jaringan mesin apa adanya dan
# MySQL tidak perlu dibuka ke antarmuka mana pun.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=klinik
DB_PASSWORD=ISI_DARI_KELUARAN_SIAPKAN_SERVER
DB_NAME=app_klinik

# === Server ===
# production menyalakan cookie Secure + HSTS. Ini WAJIB di server, dan hanya
# aman karena Caddy sudah melayani https — menyalakannya di http membuat login
# gagal DIAM-DIAM: peramban menolak menyimpan cookie Secure dari halaman http,
# tanpa pesan error apa pun di sisi aplikasi.
APP_ENV=production

PORT=4000
# Hanya mendengar di localhost; Caddy yang menghadap internet. catering memakai
# 8080 di mesin yang sama, jadi keduanya tidak berebut port.
BIND_ADDR=127.0.0.1

# Folder hasil build Vue. Sudah diisi di dalam image (ENV WEB_DIR=/app/web),
# jadi baris ini normalnya tidak perlu — dicantumkan supaya jelas bahwa nilai
# bawaan `../web/dist` tidak berlaku di dalam container.
WEB_DIR=/app/web

# === Akun bidan pertama ===
# Dipakai HANYA saat tabel users masih kosong; setelah akun ada, nilainya
# diabaikan sepenuhnya dan aplikasi mencatat "ADMIN_PASSWORD diabaikan" di log.
# Minimal 10 karakter.
#
# Kosongkan setelah akunnya terbentuk. Rahasia yang menganggur di .env adalah
# rahasia yang tidak ada yang merasa bertanggung jawab merotasinya.
ADMIN_USERNAME=bidan
ADMIN_PASSWORD=

# === CORS ===
# Frontend disajikan aplikasi ini sendiri, dari origin yang sama, jadi tidak ada
# permintaan lintas asal yang perlu diizinkan. KOSONGKAN.
CORS_ORIGINS=
