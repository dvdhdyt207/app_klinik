# Salin ke `.env` lalu isi kredensial DB Anda.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=app_klinik

# development | production
# production menyalakan cookie Secure + HSTS, jadi HANYA dipakai bila situs
# sudah dilayani lewat https. Menyalakannya di http membuat login gagal
# diam-diam: peramban menolak menyimpan cookie Secure dari halaman http.
APP_ENV=development

PORT=4000
# Antarmuka yang didengar. Di produksi biarkan 127.0.0.1 — hanya Caddy yang
# menghadap internet. Isi 0.0.0.0 hanya bila memang perlu diakses langsung.
BIND_ADDR=127.0.0.1

# Folder hasil build Vue yang di-serve (relatif dari server/)
WEB_DIR=../web/dist

# Akun bidan pertama. Dipakai HANYA saat tabel users masih kosong; setelah akun
# ada, nilai ini diabaikan sepenuhnya, sehingga sandi yang diganti lewat
# aplikasi tidak tertimpa saat server hidup lagi. Minimal 10 karakter.
# Sebaiknya dikosongkan setelah akunnya terbentuk.
ADMIN_USERNAME=bidan
ADMIN_PASSWORD=

# Origin yang boleh memanggil API dari peramban, dipisah koma.
# Di produksi frontend disajikan dari origin yang sama, jadi normalnya KOSONG.
# Saat development memakai Vite dev server, isi: http://localhost:5173
CORS_ORIGINS=
